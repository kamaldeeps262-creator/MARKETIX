# =====================================================================
# MARKETIX Environment Configuration Template
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
#
# Note: MARKETIX will automatically use embedded SQLite (database/marketix.db)
# if PostgreSQL is not installed or offline, so you can run the app immediately.
# =====================================================================

# PostgreSQL Configuration (Optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketix
DB_USER=postgres
DB_PASSWORD=your_password_here

# SQLite Fallback Path (Zero-config out of the box)
SQLITE_DB_PATH=database/marketix.db
