# =====================================================================
# MARKETIX — Comprehensive Production .gitignore
# Hides sensitive environment secrets, credentials, caches, and OS files
# =====================================================================

# Environment variables & sensitive credentials (NEVER commit these)
.env
.env.*
*.env
.env.local
.env.development
.env.production
!.env.example
.streamlit/secrets.toml
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials/

# Python compiled bytecode & caching
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Operating System temporary and metadata files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Logs, databases and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.bak
*.tmp
*.temp

# Large Archive backups (keep repo lightweight)
*.zip
*.tar.gz
*.rar
*.7z
